# config.yaml — drivecheck configuration
# Copy this file to config.yaml and edit before running.

# Single-user authentication lives outside this file: scripts/set_password.py
# writes <data dir>/auth.json (salted scrypt hash), and the session signing key
# is generated into <data dir>/secret_key on first start.

# Data directory (reports stored here). Relative to project root or absolute.
data_dir: "./data"

# Flask server settings
host: "0.0.0.0"
port: 5000
debug: false
